{
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "staging.inhockia.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(admin|dashboard|settings|messages|inbox|home|pulse|search|discover|discovery|notifications|complete-profile|onboarding|auth|email-action|verify-email|forgot-password|reset-password|offline|saved|shortlist|shortlists|signin)(/.*)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(l|invite|investors)/(.+)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(members|players|brands)/id/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/opportunities/(applications|new)(/.*)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/opportunities/([^/]+)/applicants(/.*)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/signup/email(/.*)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://*.posthog.com https://*.sentry.io https://www.googletagmanager.com https://www.google-analytics.com https://maps.googleapis.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://ivjkdaylalhsteyyclvl.supabase.co https://xtertgftujnebubxgqit.supabase.co https://flagcdn.com https://maps.gstatic.com https://maps.googleapis.com https://www.googletagmanager.com https://www.google-analytics.com https://analytics.google.com https://img.youtube.com https://i.ytimg.com https://videodelivery.net https://*.cloudflarestream.com; connect-src 'self' https://*.posthog.com https://ivjkdaylalhsteyyclvl.supabase.co https://xtertgftujnebubxgqit.supabase.co https://*.sentry.io https://www.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://stats.g.doubleclick.net https://maps.googleapis.com https://places.googleapis.com https://upload.cloudflarestream.com https://videodelivery.net https://*.cloudflarestream.com wss://ivjkdaylalhsteyyclvl.supabase.co wss://xtertgftujnebubxgqit.supabase.co; media-src 'self' blob: https://ivjkdaylalhsteyyclvl.supabase.co https://xtertgftujnebubxgqit.supabase.co https://videodelivery.net https://*.cloudflarestream.com; frame-src https://challenges.cloudflare.com https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://drive.google.com https://iframe.videodelivery.net https://*.cloudflarestream.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/manifest.json",
      "destination": "/manifest.json"
    },
    {
      "source": "/llms.txt",
      "destination": "/llms.txt"
    },
    {
      "source": "/api/sitemap.xml",
      "destination": "https://xtertgftujnebubxgqit.supabase.co/functions/v1/sitemap"
    },
    {
      "source": "/opportunities/:id([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})",
      "destination": "/api/opportunity-page?id=:id"
    },
    {
      "source": "/opportunities",
      "destination": "/api/page-head?path=/opportunities"
    },
    {
      "source": "/community",
      "destination": "/api/page-head?path=/community"
    },
    {
      "source": "/world",
      "destination": "/api/page-head?path=/world"
    },
    {
      "source": "/world/clubs/:id([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})",
      "destination": "/api/world-page?club=:id"
    },
    {
      "source": "/world/:slug([a-zA-Z][a-zA-Z-]{1,60})",
      "destination": "/api/world-page?country=:slug"
    },
    {
      "source": "/marketplace",
      "destination": "/api/page-head?path=/marketplace"
    },
    {
      "source": "/developers",
      "destination": "/api/page-head?path=/developers"
    },
    {
      "source": "/about",
      "destination": "/api/page-head?path=/about"
    },
    {
      "source": "/faq",
      "destination": "/api/page-head?path=/faq"
    },
    {
      "source": "/terms",
      "destination": "/api/page-head?path=/terms"
    },
    {
      "source": "/privacy-policy",
      "destination": "/api/page-head?path=/privacy-policy"
    },
    {
      "source": "/signup",
      "destination": "/api/page-head?path=/signup"
    },
    {
      "source": "/signup/email",
      "destination": "/api/page-head?path=/signup/email"
    },
    {
      "source": "/signin",
      "destination": "/api/page-head?path=/signin"
    },
    {
      "source": "/juniors-waitlist",
      "destination": "/api/page-head?path=/juniors-waitlist"
    },
    {
      "source": "/:key([0-9a-f]{32}).txt",
      "destination": "/api/indexnow-key?key=:key"
    },
    {
      "source": "/:path((?!assets/).*)",
      "destination": "/app.html"
    }
  ]
}
