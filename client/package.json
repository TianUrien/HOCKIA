{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage --reporter=verbose",
    "test:watch": "vitest watch",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:smoke": "playwright test --grep @smoke --project=setup --project=chromium --project=chromium-player --project=chromium-club --project=chromium-coach --project=chromium-brand --project=mobile-player",
    "test:e2e:auth": "playwright test --project=setup --project=chromium-player",
    "test:e2e:all": "playwright test",
    "test:all": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run test:e2e:smoke",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:staging": "E2E_STAGING_MODE=1 playwright test --project=setup --project=staging",
    "cap:sync": "npx cap sync ios && npx cap sync android",
    "cap:open": "npx cap open ios",
    "cap:build": "npm run build && node scripts/assert-prod-bundle.mjs && cp dist/app.html dist/index.html && npx cap sync ios && npx cap sync android",
    "sentry:dsyms": "sentry-cli debug-files upload",
    "gen:types": "npx supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" > src/lib/database.types.ts",
    "knip": "knip --include files,dependencies,unlisted,binaries,unresolved",
    "audit:check": "node scripts/audit-check.mjs",
    "tokens:build": "node scripts/build-tokens.mjs",
    "postbuild": "node scripts/prerender-landing.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capawesome/capacitor-badge": "^8.0.4",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@sentry/capacitor": "4.4.0",
    "@sentry/react": "10.69.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-virtual": "^3.14.21",
    "@types/papaparse": "^5.5.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.545.0",
    "papaparse": "^5.7.0",
    "posthog-js": "^1.438.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tus-js-client": "^4.3.1",
    "web-vitals": "^5.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.64.1",
    "@sentry/vite-plugin": "^4.6.1",
    "@sparticuz/chromium": "^147.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.0.12",
    "autoprefixer": "^10.6.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.4.0",
    "jsdom": "^27.2.0",
    "knip": "^6.42.1",
    "playwright": "1.64.1",
    "playwright-core": "^1.62.0",
    "postcss": "^8.5.31",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "npm:rolldown-vite@7.1.14",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.12",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14",
    "immer": "11.1.4",
    "dompurify": "3.4.17"
  }
}
